# Apptainer definition file for example. `ramekin build` builds it for the
# device's platform (see "Converting a Dockerfile or container image" in the
# Ramekin README for the Dockerfile equivalents).
Bootstrap: docker
From: cgr.dev/chainguard/wolfi-base:latest

%files
    app.sh /usr/local/bin/app

%post
    # Packages come from the Wolfi repository, e.g. python-3.12 or nodejs.
    # On a workstation of another architecture, this runs under qemu binfmt.
    apk add --no-cache figlet

%runscript
    # ramekind runs this on the device. Handle SIGTERM (as app.sh does) so
    # updates can stop the app gracefully.
    exec /bin/sh /usr/local/bin/app "$@"
